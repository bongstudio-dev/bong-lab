---
// El <head> común de las páginas del sitio: título, descripción, fuentes (Familjen Grotesk para títulos, DM Sans para
// todo lo demás), tokens.css y base.css (el CSS central, que también lee la librería de componentes) y el buscador
// con alcance. En el slot, lo que sume cada página (por ejemplo, los datos para compartir una nota).
interface Props {
  titulo: string;
  descripcion: string;
  raiz: "../" | "../../";                 // de la página a profertil/
  temaColor?: boolean;                    // barra del navegador en azul
  mono?: boolean;                         // DM Mono (cifras de las listas)
  barraVista?: boolean;                   // componentes/barra-vista.js: la barra de vista de las listas
  alcance: { seccion: string; nombre: string; en?: string; previa?: boolean };
}
const { titulo, descripcion, raiz, temaColor = false, mono = false, barraVista = false, alcance } = Astro.props;
const fuentes = "https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600" + (mono ? "&family=DM+Mono" : "") + "&display=swap";
---
<title>{titulo}</title>
<meta name="description" content={descripcion}>
<meta name="color-scheme" content="only light">
{temaColor && <meta name="theme-color" content="#003DA5">}
<slot />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href={fuentes} rel="stylesheet">
<link rel="stylesheet" href={raiz + "componentes/tokens.css"}>
<link rel="stylesheet" href={raiz + "componentes/base.css"}>
<link rel="stylesheet" href={raiz + "buscador/alcance.css"}>
{barraVista && <script is:inline src={raiz + "componentes/barra-vista.js"}></script>}
<script is:inline src={raiz + "buscador/alcance.js"} data-seccion={alcance.seccion} data-nombre={alcance.nombre} data-en={alcance.en} data-modo={alcance.previa ? "previa" : undefined} defer></script>
