---
// Marco de las páginas de productos (catálogo y ficha): la misma estructura que la Biblioteca y la Sala de prensa. Detrás queda fijo un
// fondo de Formas en dither (el motor de la librería, c/fondos-motor.js): en el catálogo, un paisaje de cielo y campo; en la ficha, el
// dither de tres tonos en azul. Con fondo="foto" vuelve la foto de campo. La cabecera es una tarjeta sobre el fondo y la hoja sube por
// encima al bajar. Barra, buscador, solapas, pie y transición son los del sitio.
import Pagina from "../../componentes/Pagina.astro";
import Cabeza from "../../componentes/Cabeza.astro";
import Simbolos from "../../componentes/Simbolos.astro";
import Barra from "../../componentes/Barra.astro";
import Pie from "../../componentes/Pie.astro";
import { sitio } from "../../lib/productos";
import CSS from "./productos.css?raw";

interface Props {
  titulo: string;
  descripcion: string;
  raiz: "../" | "../../";
  foto: string;
  imagen?: string | null;
  saltar: string;
  lista?: boolean;                 // el catálogo filtra con el buscador de la barra; la ficha muestra la vista previa
  fondo?: "foto" | "paisaje" | "dither";
}
const { titulo, descripcion, raiz, foto, imagen, saltar, lista = false, fondo = "foto" } = Astro.props;
// Configuración del motor de fondos para cada caso (los mismos valores que la comparación del Lab).
const COMUN = { modo: "dither", tonos: "tres", color: "azul", acento: 1, cursor: true, clic: false, radioCursor: 160, tapa: "pf-hoja",
  ignorar: "a, button, input, select, textarea, label, summary, [role=button], .pf-bh, .pf-hoja, #pf-top" };
const FONDOS = {
  paisaje: { ...COMUN, imagen: sitio("productos/fondo-paisaje.jpg"), zonas: true, colorCampo: "verde", umbral: 8, celda: 12, contraste: 160,
    brillo: 0, encuadre: 50, viento: 22, angulo: 0, densidad: 20, velocidad: 25, forma: "trigo" },
  dither: { ...COMUN, celda: 18, angulo: 11, densidad: 15, degrade: 45, contraste: 130, velocidad: 40, forma: "urea" },
};
const cfgFondo = fondo === "foto" ? null : FONDOS[fondo];
const url = new URL(Astro.url.pathname, Astro.site);
---
<Pagina firma={{ nombre: "PROFERTIL · PRODUCTOS", que: "Catálogo y fichas de productos de Profertil.", contexto: "Prototipo del catálogo de productos para la web de Profertil." }} transicion="biblioteca" css={CSS}>
  <Cabeza slot="head" titulo={titulo + " · Profertil"} {descripcion} {raiz} temaColor solapas alcance={{ seccion: "productos", nombre: "Productos", previa: !lista }}>
    <link rel="canonical" href={url} />
    <slot name="precarga" />
    {cfgFondo ? <link rel="preload" as="script" href={sitio("componentes/c/fondos-motor.js")} /> : <link rel="preload" as="image" href={sitio(foto)} fetchpriority="high" />}
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url.href} />
    {imagen && <meta property="og:image" content={new URL(sitio(imagen), url).href} />}
  </Cabeza>
  <Simbolos badge />
  <a class="pf-saltar" href="#pf-lista">{saltar}</a>
  <div class="pr-fondo" aria-hidden="true" data-foto={sitio(foto)}>{cfgFondo ? <canvas class="pr-fondo__lienzo"></canvas> : <img src={sitio(foto)} alt="" fetchpriority="high" />}</div>
  <Barra actual="Productos y Servicios" actualEnlace={sitio("productos/")} busca={{ etiqueta: "Buscar productos", placeholder: "Buscá un producto, cultivo o nutriente" }} cuenta={lista} />
  <section class="pf-campo-cab pr-cab">
    <header class="pf-bh" id="pf-cab"><slot name="cab" /></header>
  </section>
  <div class="pf-hoja" id="pf-hoja">
    <main class="pf-col" id="pf-lista" tabindex="-1"><slot /></main>
    <Pie />
  </div>
  <slot name="fin" />
  {cfgFondo && <script is:inline src={sitio("componentes/formas.js")}></script>}
  {cfgFondo && <script is:inline src={sitio("componentes/c/fondos-motor.js")}></script>}
  {cfgFondo && <script is:inline define:vars={{ cfgFondo }}>
    // El fondo de Formas: sin WebGL 2 queda el azul liso de .pr-fondo; con movimiento reducido, un solo cuadro quieto.
    if (window.PFFondo) window.PF_FONDO = window.PFFondo(document.querySelector(".pr-fondo__lienzo"), cfgFondo);
  </script>}
  <script is:inline>
    // Barra sólida cuando la tarjeta de la cabecera llega a ella (igual que en la Biblioteca) y el alto de la barra para el CSS.
    (function () {
      var t = document.getElementById("pf-top"), cab = document.getElementById("pf-cab"), r = document.documentElement;
      function medir() { r.style.setProperty("--pf-barra-h", t.offsetHeight + "px"); }
      function solida() { t.classList.toggle("pf-barra--solida", scrollY > 0 && cab.getBoundingClientRect().top <= t.offsetHeight); }
      medir(); solida();
      addEventListener("scroll", solida, { passive: true });
      addEventListener("resize", function () { medir(); solida(); });
    })();
  </script>
</Pagina>
