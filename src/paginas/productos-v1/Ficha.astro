---
import Marco from "./Marco.astro";
import Documentos from "./Documentos.astro";
import { sitio, vistas, type Producto } from "../../lib/productos";
import { assets } from "../../lib/sistema.mjs";
import { MSDS, BIB } from "../../lib/datos.mjs";

interface Props { producto: Producto }
const { producto: { data: p } } = Astro.props;
const forma = assets().formas[p.categoria === "Agro" ? "urea" : "industria"];
const imagen = p.imagen || p.logo;
const biblioteca = [...MSDS, ...BIB];
const recursos = p.documentos.map(d => {
  const doc = biblioteca.find(v => v.l && d.ruta === "biblioteca/pdf/" + v.l);
  return { ...d, visor: doc ? sitio("biblioteca/" + doc.id + "/") : null };
});
const hojas = recursos.filter(d => d.tipo === "seguridad");
const hoja = hojas[0];
const documentos = recursos.filter(d => d.tipo !== "boletin");
const boletines = recursos.filter(d => d.tipo === "boletin");
const medios = p.enlaces.filter(e => e.tipo === "video" || e.tipo === "podcast");
const enlaces = p.enlaces.filter(e => e.tipo !== "video" && e.tipo !== "podcast");
const secciones = [
  { id: "caracteristicas", nombre: "Características generales", visible: p.caracteristicas.length },
  { id: "descripcion", nombre: "Descripción", visible: p.descripcion.length },
  { id: "uso", nombre: "Recomendaciones de uso", visible: p.recomendaciones.length },
  { id: "cultivos", nombre: "Cultivos", visible: p.cultivos.length },
  { id: "galeria", nombre: "Tecnología y producción", visible: p.galeria.length },
  { id: "recursos", nombre: "Documentos y recursos", visible: documentos.length + enlaces.length },
  { id: "boletines", nombre: "Boletines técnicos", visible: boletines.length },
  { id: "multimedia", nombre: "Multimedia", visible: medios.length },
].filter(s => s.visible);
const primera = secciones[0];
const normalizar = (s: string) => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
const vistaCultivo = (nombre: string) => vistas.find(v => v.tipo === "cultivo" && normalizar(v.nombre) === normalizar(nombre));
---
<Marco titulo={p.nombre} descripcion={p.bajada} raiz="../../" imagen={imagen}>
  <header class="pr-portada">
    <div class="pr-ancho">
      <nav class="pr-migas" aria-label="Ruta de navegación">
        <a href={sitio("productos/")}>Catálogo de productos</a><span aria-hidden="true">/</span>
        <a href={sitio("productos/#" + p.categoria.toLowerCase())}>{p.categoria}</a>
      </nav>
      <div class="pr-apertura">
        <div class="pr-titular">
          <h1>{p.nombre}</h1>
          <p class="pr-bajada">{p.bajada}</p>
          {p.archivada && <p class="pr-archivo">Ficha de archivo · Relevamiento de agosto de 2026</p>}
          <div class="pr-acciones">
            {primera && <a class="pf-boton pf-boton--principal" href={"#" + primera.id}>{primera.id === "caracteristicas" ? "Ver características" : "Ver descripción"} <span aria-hidden="true">↓</span></a>}
            {hojas.length > 1 ? <a class="pf-boton" href="#recursos">Hojas de seguridad <span aria-hidden="true">↓</span></a> :
              hoja && <a class="pf-boton" href={hoja.visor || sitio(hoja.ruta)} target={hoja.visor ? undefined : "_blank"} rel={hoja.visor ? undefined : "noopener"}>Hoja de seguridad <span aria-hidden="true">{hoja.visor ? "→" : "↗"}</span></a>}
          </div>
        </div>
        <figure class:list={["pr-arte", { "pr-industria": p.categoria === "Industrial", "pr-foto": imagen?.endsWith(".jpg") }]}>
          <svg class="pr-forma" viewBox={forma.vb} aria-hidden="true" set:html={forma.d} />
          {imagen && <img class="pr-producto" src={sitio(imagen)} alt={p.nombre} fetchpriority="high" />}
          {p.logo && p.imagen && p.logo !== p.imagen && <img class="pr-marca" src={sitio(p.logo)} alt="" />}
        </figure>
      </div>
    </div>
  </header>
  <div class="pr-ancho pr-lectura">
    <nav class="pr-indice" aria-label="En esta ficha">
      <p>En esta ficha</p>
      {secciones.map(s => <a href={"#" + s.id}>{s.nombre}</a>)}
    </nav>
    <div class="pr-cuerpo">
      {!!p.caracteristicas.length && <section id="caracteristicas">
        <h2>Características generales</h2>
        <dl class="pr-datos">{p.caracteristicas.map(c => <div><dt>{c.etiqueta}</dt><dd>{c.valor}</dd></div>)}</dl>
      </section>}
      {!!p.descripcion.length && <section id="descripcion"><h2>Descripción</h2>{p.descripcion.map(t => <p>{t}</p>)}</section>}
      {!!p.recomendaciones.length && <section id="uso"><h2>Recomendaciones de uso</h2>{p.recomendaciones.map(t => <p>{t}</p>)}</section>}
      {!!p.cultivos.length && <section id="cultivos"><h2>Cultivos</h2>
        <ul class="pr-cultivos">{p.cultivos.map(c => {
          const v = vistaCultivo(c);
          return <li>{v ? <a class="pf-boton" href={sitio(v.ruta + "/")}>{c} <span aria-hidden="true">→</span></a> : <span>{c}</span>}</li>;
        })}</ul>
      </section>}
      {!!p.galeria.length && <section id="galeria"><h2>Tecnología y producción</h2>
        <div class="pr-galeria">{p.galeria.map(g => <figure><img src={sitio(g.ruta)} alt="" loading="lazy" /><figcaption>{g.titulo}</figcaption></figure>)}</div>
      </section>}
      {(documentos.length > 0 || enlaces.length > 0) && <section id="recursos"><h2>Documentos y recursos</h2>
        <Documentos items={documentos} />
        {!!enlaces.length && <ul class="pr-recursos">{enlaces.map(e => <li>
          <a class="pr-enlace" href={e.tipo === "producto" ? sitio(e.url) : e.url}>{e.titulo} <span aria-hidden="true">{e.tipo === "producto" ? "→" : "↗"}</span></a>
        </li>)}</ul>}
      </section>}
      {!!boletines.length && <section id="boletines"><h2>Boletines técnicos</h2><Documentos items={boletines} /></section>}
      {!!medios.length && <section id="multimedia"><h2>Multimedia</h2>
        <ul class="pr-recursos">{medios.map(e => <li><a class="pr-enlace" href={e.url}>
          <small>{e.tipo === "podcast" ? "Escuchar podcast" : "Ver video"}</small>{e.titulo} <span aria-hidden="true">↗</span>
        </a></li>)}</ul>
      </section>}
      {p.notaFuente && <p class="pr-nota-fuente">{p.notaFuente}</p>}
      <div class="pr-fin">
        <a href={sitio("productos/")}>← Volver al catálogo</a>
        {!p.archivada && <a href={p.fuente}>Ver ficha original ↗</a>}
      </div>
    </div>
  </div>
</Marco>
