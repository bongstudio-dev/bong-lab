---
import Pagina from "../../componentes/Pagina.astro";
import Cabeza from "../../componentes/Cabeza.astro";
import Simbolos from "../../componentes/Simbolos.astro";
import Barra from "../../componentes/Barra.astro";
import Pie from "../../componentes/Pie.astro";
import { sitio } from "../../lib/productos";
import CSS from "./productos.css?raw";

interface Props {
  titulo: string;
  descripcion: string;
  raiz: "../" | "../../";
  imagen?: string | null;
}
const { titulo, descripcion, raiz, imagen } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---
<Pagina firma={{ nombre: "PROFERTIL · PRODUCTOS", que: "Catálogo y fichas de productos de Profertil.", contexto: "Sitio de Profertil." }} transicion="biblioteca" css={CSS}>
  <Cabeza slot="head" titulo={titulo + " · Profertil"} {descripcion} {raiz} temaColor alcance={{ seccion: "productos", nombre: "Productos", previa: true }}>
    <link rel="canonical" href={url} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url.href} />
    {imagen && <meta property="og:image" content={new URL(sitio(imagen), url).href} />}
  </Cabeza>
  <Simbolos />
  <a class="pf-saltar" href="#contenido">Ir al contenido</a>
  <Barra solida actual="Productos y Servicios" actualEnlace={sitio("productos/")} logo={{ href: sitio("productos/"), etiqueta: "Profertil, ir al catálogo de productos" }} busca={{ etiqueta: "Buscar productos", placeholder: "Buscá un producto o cultivo" }} />
  <main id="contenido" tabindex="-1"><slot /></main>
  <Pie />
</Pagina>
