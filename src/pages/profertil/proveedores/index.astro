---
// Proveedores: Quiero ser proveedor, Licitaciones Ariba y Legajo impositivo en una sola página con la plantilla de la Biblioteca.
// Las tres secciones son solapas (la pieza "solapas" de base.css, la de Inversores y Sala de prensa) y cambian el contenido sin
// cambiar de página. Las dos primeras son de tarjetas (PAG.secciones[].tarjetas): el alta, los PDF y los portales como accesos.
// El Legajo es una lista de documentos con sus filtros, como su página. Los PDF abren en la página del documento de la Biblioteca.
import Lista from "../../../componentes/Lista.astro";
import { PROVEEDORES, LEGAJO, LEGAJO_GRUPOS, LEGAJO_ZIP } from "../../../lib/datos.mjs";
const FORM = "https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=mSN4cDytpky4qa8rr7xXBH0y8EVhYWtJv-JN5bM1CXhUMlhFTTJINVRTOTNPSTkyU0VDSTQ1N09TSC4u";
// Bajada de cada PDF (el título ya dice qué es).
const BAJADAS = {
  "proveedores-codigo-de-conducta-etica": "Los principios que esperamos de quienes trabajan con nosotros.",
  "proveedores-condiciones-generales-de-compras": "Cómo compramos y contratamos: plazos, entregas, facturación y pagos.",
  "proveedores-lineamientos-de-seguridad-de-la-informacion": "Cómo cuidar la información de Profertil que manejás como proveedor.",
};
const SECCIONES = [
  { id: "quiero-ser-proveedor", nombre: "Quiero ser proveedor", uno: "acceso", varios: "accesos", todo: "Quiero ser proveedor", orden: "o",
    intro: "Si tu empresa es de Argentina o del exterior, acá encontrás lo necesario para registrarte y formar parte de nuestra base de proveedores.",
    tarjetas: [
      { tipo: "form", t: "Planilla de información de proveedores", b: "Completá el formulario con los datos de tu empresa para iniciar el alta.", href: FORM, ir: "Completar el formulario", k: 2 },
      ...PROVEEDORES.map((d, i) => ({ tipo: "doc", id: d.id, l: d.l, t: d.t, b: BAJADAS[d.id], ir: "Ver documento", k: i + 4 })),
      { tipo: "portal", t: "Checkpagos", b: "Consultá el estado de tus facturas y pagos.", href: "https://checkpagos.com/", ir: "Acceder a Checkpagos", k: 8 },
      { tipo: "portal", t: "Certronic", b: "Presentá y renová la documentación de tu personal y tu empresa.", href: "https://certronic.io/portal/pages/login.php", ir: "Acceder a Certronic", k: 9 },
    ] },
  { id: "licitaciones-ariba", nombre: "Licitaciones Ariba", uno: "acceso", varios: "accesos", todo: "Licitaciones Ariba", orden: "o",
    intro: "Ariba es la plataforma que usa Profertil para gestionar las licitaciones con sus proveedores.",
    tarjetas: [
      { tipo: "portal", t: "Ariba Network", b: "La plataforma de licitaciones y sourcing de Profertil.", href: "https://service.ariba.com/Sourcing.aw/109578013/aw", ir: "Acceder a Ariba", k: 11 },
      { tipo: "pronto", t: "Manuales de uso", b: "Documentación de apoyo para operar en la plataforma.", k: 12 },
      { tipo: "pronto", t: "Videos tutoriales", b: "Capacitaciones paso a paso.", k: 13 },
    ] },
  { id: "legajo-impositivo", nombre: "Legajo impositivo", docs: LEGAJO, grupos: LEGAJO_GRUPOS.map((g) => ({ ...g, sin: false })),
    todo: "Todo el legajo", uno: "documento", varios: "documentos", orden: "o",
    intro: "Nuestro legajo impositivo actualizado, con las constancias nacionales y provinciales.",
    accion: { href: "../biblioteca/archivos/" + LEGAJO_ZIP.l, texto: "Descargar todo (ZIP)", descarga: true } },
];
const CSS = `
/* Proveedores: orden fijo, sin selector. En el Legajo la fila es el ícono, la constancia, el vencimiento y la descarga
   (como su página): el rótulo de la etiqueta sobra. */
.pf-orden { display: none; }
.pf-docs[data-vista="lista"] .pf-doc { grid-template-columns: 34px minmax(0, 1fr) max-content 36px; }
.pf-docs[data-vista="lista"] .pf-etiqueta__rotulo { display: none; }
.pf-docs[data-vista="compacta"] .pf-doc { grid-template-columns: 22px minmax(0, 1fr) max-content 30px; }
.pf-doc__y { white-space: nowrap; }
@media (max-width: 640px) {
  .pf-docs[data-vista="lista"] .pf-doc { grid-template-columns: 30px minmax(0, 1fr) 36px; row-gap: 2px; }
  .pf-docs[data-vista="lista"] .pf-doc .pf-etiqueta { grid-column: 1; grid-row: 1 / span 2; align-self: start; }
  .pf-docs[data-vista="lista"] .pf-doc__t { grid-column: 2; grid-row: 1; }
  .pf-docs[data-vista="lista"] .pf-doc__y { grid-column: 2; grid-row: 2; text-align: left; }
  .pf-docs[data-vista="lista"] .pf-doc__y:empty { display: none; }
  .pf-docs[data-vista="lista"] .pf-doc__d { grid-column: 3; grid-row: 1 / span 2; align-self: center; }
}
`;
---
<Lista
  titulo="Proveedores Profertil"
  descripcion="Maqueta de Proveedores de profertil.com.ar sobre el concepto web del manual de marca: el alta, la documentación, los portales, las licitaciones en Ariba y el legajo impositivo en una sola página."
  firma={{ nombre: "PROFERTIL · PROVEEDORES", que: "Maqueta de Proveedores: el alta, la documentación, los portales, Ariba y el legajo impositivo.", contexto: "Prototipo de la página de Proveedores para la web de Profertil." }}
  alcance={{ seccion: "proveedores", nombre: "Proveedores", en: "Proveedores" }}
  saltar="Ir a Proveedores"
  busca={{ etiqueta: "Buscar en Proveedores", placeholder: "Buscá: formulario, Ariba, constancia…" }}
  h1="Proveedores"
  bajada="Trabajamos junto a proveedores nacionales e internacionales para que el abastecimiento sea transparente, eficiente y sostenible. Acá encontrás cómo registrarte, nuestras licitaciones y la documentación que aplica."
  vaciar="Ver todo"
  docs={[]}
  grupos={[]}
  pag={{ base: "../biblioteca/", titulo: "Proveedores Profertil", secciones: SECCIONES,
    campo: { color: "amarillo", forma: "industria", tema: ["industria", "capas"] } }}
  acciones={[{ href: "mailto:compras@profertil.com.ar", texto: "compras@profertil.com.ar", icono: "mail" }]}
  css={CSS}
/>
