---
// Portada de esfera, versión Índice (Sostenibilidad): arriba, a qué se puede ir. Accesos a las páginas de la esfera en la
// primera pantalla y bloques que se despliegan. Corta y útil.
// 00A barra sobre claro · 01C hero con fondo de marca · 02B enunciado y accesos · 03C tres bloques que se despliegan ·
// 04A cifras · 06C marquesina · 07A grilla de notas · 08B contactos por área · 09 pie.
import Marco from "../../../../paginas/portadas/Marco.astro";
import Cifras from "../../../../paginas/portadas/Cifras.astro";
import Notas from "../../../../paginas/portadas/Notas.astro";
import Contactos from "../../../../paginas/portadas/Contactos.astro";
import { pieza, fondo, forma } from "../../../../lib/piezas.mjs";
import { HERO, ACCESOS, BLOQUES, MARQUESINA } from "../../../../paginas/portadas/contenido.mjs";

const fondoHero = fondo("fondo-patron", "pf-po-lienzo", { variante: "grupos", color: "verde", tapa: "pf-po-hoja" });
const lv = pieza("lista-valores", { variante: "filas", acento: "verde" });
const cifras = pieza("cifras", { variante: "tarjeta", paleta: "verde", comb: "terciaria", num: 64 });
const filas = [["Ambiente", BLOQUES.gestion], ["Energía", BLOQUES.energia], ["Comunidad", BLOQUES.comunidad]] as const;
const FLECHA = '<svg class="pf-po-flecha" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const AFUERA = '<svg class="pf-po-flecha" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>';
const marquesina = Array(4).fill(MARQUESINA).join("  ·  ") + "  · ";
---
<Marco version="Índice" ritmo="corto" barra="solida" formas hoja css={fondoHero.css + "\n" + lv.css + "\n" + cifras.css} js={fondoHero.js + "\n" + lv.js}>
  <header class="pf-po-hero pf-po-hero--fondo" slot="hero">
    <canvas class="pf-fondo__lienzo" id="pf-po-lienzo" aria-hidden="true"></canvas>
    <div class="pf-po-ancho">
      <div class="pf-po-hero__tarjeta">
        <h1 data-anim="sube" data-disparo="carga">{HERO.titulo}</h1>
        <p class="pf-po-hero__bajada" data-anim="funde" data-disparo="carga">{HERO.bajada}</p>
      </div>
    </div>
  </header>

  <section class="pf-po-sec pf-po-ancho" aria-labelledby="pf-po-enunciado">
    <p class="pf-po-enunciado" id="pf-po-enunciado">Todo lo que hacemos para cuidar el suelo, el ambiente y la comunidad, en un solo lugar.</p>
    <ul class="pf-po-accesos">
      {ACCESOS.map((a) => (
        <li>
          <a class:list={["pf-po-acceso", { "pf-po-acceso--externo": a.externo }]} href={a.href} {...(a.externo ? { target: "_blank", rel: "noopener" } : {})}>
            <Fragment set:html={forma(a.forma, "pf-po-acceso__forma")} />
            <h2 class="pf-po-acceso__t">{a.t}</h2>
            <p class="pf-po-acceso__d">{a.d}</p>
            <Fragment set:html={a.externo ? AFUERA : FLECHA} />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="pf-po-sec pf-po-ancho" aria-labelledby="pf-po-lv-t">
    <div class="pf-po-cab"><h2 class="pf-po-h2" id="pf-po-lv-t">Cómo lo hacemos</h2></div>
    <div class="pf-lv" data-c="lista-valores" data-variante="filas" data-acento={lv.s.acento} data-regla="true" style={lv.style}>
      <ol class="pf-lv__filas">
        <span class="pf-lv__barra" aria-hidden="true"></span>
        {filas.map(([palabra, b], i) => (
          <li class="pf-lv__fila">
            <span class="pf-lv__num">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="pf-lv__palabra" style="margin:0">{palabra}</h3>
            <div class="pf-lv__abre"><div><p>{b.p}</p><img src={b.foto} alt={b.alt} loading="lazy" decoding="async" /></div></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pf-po-sec pf-po-ancho" aria-label="Datos"><Cifras attrs={cifras.attrs} style={cifras.style} /></section>

  <section class="pf-po-sec" aria-label={MARQUESINA}>
    <div class="pf-po-marq"><p data-anim="marquesina">{marquesina}</p></div>
  </section>

  <Notas />
  <Contactos />
</Marco>
