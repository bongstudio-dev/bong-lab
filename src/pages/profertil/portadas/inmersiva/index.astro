---
// Portada de esfera, versión Inmersiva (Sostenibilidad): la imagen manda. Foto a sangre, texto fijo con fotos que pasan
// y pausas de color. Más scroll y menos lectura.
// 00B barra sobre la foto · 01B video a sangre · 02C pregunta y respuesta · 03B cinco bloques con texto fijo ·
// 04B cita · 05B foto a pantalla completa · 06B frase sobre fondo de marca · 07B documentos · 08C frase y botón fijo · 09 pie.
import Marco from "../../../../paginas/portadas/Marco.astro";
import Cita from "../../../../paginas/portadas/Cita.astro";
import Docs from "../../../../paginas/portadas/Docs.astro";
import { pieza, fondo } from "../../../../lib/piezas.mjs";
import { HERO, PREGUNTA, BLOQUES, FRASE, FOTOS, VISITA } from "../../../../paginas/portadas/contenido.mjs";

const sf = pieza("scroll-fotos", { variante: "paginas", etiqueta: false, oscuro: 34 });
const fondoMarca = fondo("fondo-grilla", "pf-po-lienzo", { variante: "formas", color: "verde", forma: "plantas" });
const lista = [BLOQUES.gestion, BLOQUES.huella, BLOQUES.energia, BLOQUES.comunidad, BLOQUES.puertas];
const linea = (t: string) => `<span class="pf-sf__linea"><span style="--k:0">${t}</span></span>`;
const FLECHA = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Marco version="Inmersiva" ritmo="medio" barra="foto" formas css={sf.css + "\n" + fondoMarca.css} js={sf.js + "\n" + fondoMarca.js}>
  <header class="pf-po-hero pf-po-hero--foto" slot="hero">
    <video src={FOTOS.video} poster={FOTOS.poster} autoplay muted loop playsinline aria-hidden="true"></video>
    <div class="pf-po-ancho">
      <h1 data-anim="sube" data-disparo="carga">{HERO.titulo}</h1>
      <p class="pf-po-hero__bajada" data-anim="funde" data-disparo="carga">{HERO.bajada}</p>
    </div>
  </header>

  <section class="pf-po-sec pf-po-ancho pf-po-dos" aria-labelledby="pf-po-pregunta">
    <h2 class="pf-po-h2" id="pf-po-pregunta" data-anim="ventana">{PREGUNTA.p}</h2>
    <p data-anim="funde">{PREGUNTA.r}</p>
  </section>

  <div class="pf-po-acompana">
    <section class="pf-po-sec" aria-label="Cómo lo hacemos">
      <div class="pf-sf" data-c="scroll-fotos" data-variante={sf.s.variante} data-etiqueta="false" style={sf.style}>
        <div class="pf-sf__fijo" data-modo="paginas" style={"height: " + lista.length * 100 + "vh"}>
          <div class="pf-sf__fijo-in">
            {lista.map((b) => <article class="pf-sf__panel"><div class="pf-sf__media"><img src={b.foto} alt={b.alt} decoding="async" /></div></article>)}
            <div class="pf-sf__textos">
              {lista.map((b) => <div class="pf-sf__txt"><h3 set:html={linea(b.t)} /><p set:html={linea(b.p)} /></div>)}
            </div>
            <ol class="pf-po-sfi" aria-hidden="true">{lista.map((_, i) => <li>{String(i + 1).padStart(2, "0")}</li>)}</ol>
          </div>
        </div>
      </div>
    </section>

    <section class="pf-po-sec pf-po-ancho" aria-label="Testimonio"><Cita /></section>

    <figure class="pf-po-foto pf-po-sec" style="padding:0;margin-top:var(--aire)"><img src={FOTOS.campo} alt="Campo de trigo verde bajo un cielo con nubes" loading="lazy" decoding="async" /></figure>

    <section class="pf-po-color" aria-label="Afirmación">
      <canvas class="pf-fondo__lienzo" id="pf-po-lienzo" aria-hidden="true"></canvas>
      <div class="pf-po-ancho"><p class="pf-po-frase" data-anim="cortina">{FRASE}</p></div>
    </section>

    <Docs />

    <section class="pf-po-sec pf-po-ancho" aria-labelledby="pf-po-visita">
      <p class="pf-po-acompana__frase" id="pf-po-visita" data-anim="sube">{VISITA.frase}</p>
    </section>
    <div class="pf-po-acompana__fijo pf-po-ancho"><a class="pf-boton-color" href={VISITA.href}>{VISITA.boton}<Fragment set:html={FLECHA} /></a></div>
  </div>
</Marco>
